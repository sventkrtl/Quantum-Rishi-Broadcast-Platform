# =============================================================================
# Quantum Rishi Broadcast Platform - .gitattributes
# =============================================================================
# Normalize line endings and define how Git handles specific file types.
# =============================================================================

# Default to auto-normalization for text files.
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Documentation
# -----------------------------------------------------------------------------
*.md       text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.txt      text eol=lf
*.rst      text eol=lf
LICENSE    text eol=lf
NOTICE     text eol=lf

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.conf     text eol=lf
*.editorconfig  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.env.example    text eol=lf
CODEOWNERS      text eol=lf

# -----------------------------------------------------------------------------
# Scripts (implementation-agnostic - declared now, used at implementation time)
# -----------------------------------------------------------------------------
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.fish     text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# -----------------------------------------------------------------------------
# Templates
# -----------------------------------------------------------------------------
*.template text eol=lf
*.tpl      text eol=lf
*.example  text eol=lf

# -----------------------------------------------------------------------------
# Binary files (do not normalize)
# -----------------------------------------------------------------------------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.bmp      binary
*.ico      binary
*.icns     binary
*.tif      binary
*.tiff     binary
*.webp     binary
*.avif     binary
*.svg      text eol=lf
*.pdf      binary
*.doc      binary
*.docx     binary
*.xls      binary
*.xlsx     binary
*.ppt      binary
*.pptx     binary
*.zip      binary
*.tar      binary
*.gz       binary
*.7z       binary
*.rar      binary
*.mp3      binary
*.mp4      binary
*.wav      binary
*.ogg      binary
*.webm     binary
*.mov      binary
*.avi      binary
*.mkv      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.eot      binary

# -----------------------------------------------------------------------------
# Linguist (GitHub language detection)
# -----------------------------------------------------------------------------
docs/* linguist-documentation
*.md   linguist-documentation

# -----------------------------------------------------------------------------
# Export-ignore (do not include in distribution archives)
# -----------------------------------------------------------------------------
.gitattributes export-ignore
.gitignore     export-ignore
.github        export-ignore
