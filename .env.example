# =============================================================================
# Quantum Rishi Broadcast Platform
# Environment Variable Template
# =============================================================================
#
# Purpose:
#   This file documents all environment variables recognized by the platform.
#   It serves as the authoritative template for local and operational
#   configuration. Copy this file to `.env` and populate values as needed.
#
# Rules:
#   1. Never commit real values, secrets, tokens, or credentials.
#   2. Never commit a populated `.env` file. `.env` is git-ignored.
#   3. Only documented variable names may be used by the platform.
#   4. Every variable below must be documented with its purpose.
#   5. Real values must be supplied through secure channels at deployment time.
#
# Usage:
#   cp .env.example .env
#
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime Environment
# -----------------------------------------------------------------------------
# Identifies the active runtime environment.
# Accepted values: development | staging | production
# Used by configuration, logging, and service layers.
QRBP_ENVIRONMENT=


# -----------------------------------------------------------------------------
# Overlay Source URL
# -----------------------------------------------------------------------------
# The canonical URL of the broadcast overlay (the "One URL" principle).
# The platform reads all visual layers from this single source.
# Must be a fully qualified URL reachable by the rendering target.
QRBP_OVERLAY_URL=


# -----------------------------------------------------------------------------
# OBS Connection - Host
# -----------------------------------------------------------------------------
# Hostname or IP address of the machine running OBS Studio with the
# OBS WebSocket plugin enabled. Used by the OBS Adapter service layer.
# Example: 127.0.0.1
QRBP_OBS_HOST=


# -----------------------------------------------------------------------------
# OBS Connection - Port
# -----------------------------------------------------------------------------
# TCP port on which the OBS WebSocket server is listening.
# Default OBS WebSocket port is typically 4444 (non-default by convention).
# Must be a numeric value between 1 and 65535.
QRBP_OBS_PORT=


# -----------------------------------------------------------------------------
# Logging Level
# -----------------------------------------------------------------------------
# Controls the verbosity of the platform logging pipeline.
# Accepted values: trace | debug | info | warn | error | fatal | silent
# Default: info
QRBP_LOG_LEVEL=
